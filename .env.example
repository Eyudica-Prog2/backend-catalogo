# =============================================================================

# backend-catalogo - environment variables

# =============================================================================

# Copy this file to .env and fill it in with your real values:

# cp .env.example .env

#

# .env is in .gitignore: NEVER commit it. Do not paste here any value that

# you have already uploaded to the repository (if you did, rotate it anyway

# as if it had been exposed).

#

# Golden rule:

# - The technical JWT for the course and passwords NEVER go into source code,

# the README, screenshots, logs, or the KMP app.

# - All values below are injected as OS environment variables

# (or via env_file in docker compose) and read with ${VAR} in application.yml.

# =============================================================================

# -----------------------------------------------------------------------------

# 1. Database (PostgreSQL 16, server; H2/SQLite in-memory are prohibited)

# -----------------------------------------------------------------------------

# Used by docker compose to create the container.

DB_NAME=catalogo
DB_USER=catalogo
DB_PASSWORD=cambio-una-password-larga-para-desarrollo

# Container port exposed on the host (used when running the service from the IDE).

DB_PORT=5433

# JDBC used by the service. Inside docker compose it is automatically overridden

# by jdbc:postgresql://catalogo-db:5432/... (see docker-compose.yml).

DB_URL=jdbc:postgresql://localhost:5433/catalogo

# HTTP port of the backend-catalogo (KMP uses 10.0.2.2:8081 from the emulator).

APP_PORT=8081
SERVER_PORT=8081

# -----------------------------------------------------------------------------

# 2. User JWT (issued by backend-catalogo; validated by backend-turnos)

# -----------------------------------------------------------------------------

# HS256. MINIMUM 32 characters (256 bits); generate one with:

# openssl rand -base64 48

# Rotating it invalidates all active sessions.

APP_JWT_SECRET=genera-aqui-un-secreto-largo-de-al-menos-32-caracteres
APP_JWT_EXPIRY_SECONDS=86400

# Key from which the AES-256-GCM symmetric key is DERIVED (SHA-256), used to

# encrypt persisted secrets (currently: redisPassword in catedra_integration).

# This is not the JWT secret: they serve different purposes and must not be reused.

APP_SECRETS_KEY=genera-aqui-otra-clave-larga-para-cifrar-datos-persistidos

# -----------------------------------------------------------------------------

# 3. CORS

# -----------------------------------------------------------------------------

# Allowed origins, separated by commas. Android does not need CORS; it is used

# for web clients during development. Empty = all cross-origin requests are rejected.

CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------

# 4. Project technical account with the course infrastructure

# -----------------------------------------------------------------------------

# Registration is performed ONCE with Postman: POST /api/student/register

# (step-by-step instructions are in the README). Copy here the id_token and the

# integration object returned by that response. See the "Technical Account

# Registration" section.

# Base URL of the course REST API (provided by the course through another channel).

CATEDRA_API_BASE_URL=http://localhost:9999

# Option A (recommended): technical login. Used to obtain the JWT through

# POST /api/authenticate (rememberMe=true). Leave empty if using Option B.

CATEDRA_LOGIN=alumno.ejemplo
CATEDRA_PASSWORD=clave-tecnica-de-la-catedra

# Option B: you already have a valid technical JWT (1 year) and want to skip login.

# If set, it takes priority over CATEDRA_LOGIN / CATEDRA_PASSWORD.

CATEDRA_JWT=

# HTTP timeouts towards the course infrastructure (milliseconds).

CATEDRA_HTTP_CONNECT_TIMEOUT_MS=3000
CATEDRA_HTTP_READ_TIMEOUT_MS=10000

# Retry with backoff when obtaining the token / refreshing the integration.

CATEDRA_RETRY_MAX_ATTEMPTS=3
CATEDRA_RETRY_INITIAL_BACKOFF_MS=300
CATEDRA_RETRY_MAX_BACKOFF_MS=3000

# --- Data from the "integration" section of the registration ------------------

# Validated against the response from GET /api/student/integration; if they differ,

# the service still starts and only emits a warning (the course infrastructure is

# the authoritative source and is persisted in the catedra_integration table).

# Redis (section 14 of the contract). The actual password is ENCRYPTED in the DB.

CATEDRA_REDIS_HOST=redis.catedra.internal
CATEDRA_REDIS_PORT=6379
CATEDRA_REDIS_USERNAME=grp_proyecto-juan-perez
CATEDRA_REDIS_PASSWORD=secreto-redis-ficticio
CATEDRA_REDIS_READ_NAMESPACE=catedra:sync:*
CATEDRA_REDIS_WRITE_NAMESPACE=alumnos:proyecto-juan-perez:*

# Kafka (section 15 of the contract).

CATEDRA_KAFKA_BOOTSTRAP_SERVERS=kafka.catedra.internal:9092
CATEDRA_KAFKA_CONSUMER_GROUP_ID=alumnos-proyecto-juan-perez
CATEDRA_KAFKA_CATALOG_TOPIC=catedra.catalog.proyecto-juan-perez
CATEDRA_KAFKA_ACTIONS_TOPIC=alumnos.turnos.acciones.proyecto-juan-perez
CATEDRA_KAFKA_PHONE_TOPIC=catedra.turnos.telefono.proyecto-juan-perez
